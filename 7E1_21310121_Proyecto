import sqlite3

# Crear y poblar la base de datos
def configurar_base_datos():
    conexion = sqlite3.connect('sistema_experto.db')
    cursor = conexion.cursor()
    
    # Crear tablas
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS enfermedades (
            id_enfermedad INTEGER PRIMARY KEY AUTOINCREMENT,
            nombre TEXT NOT NULL
        )
    ''')
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS sintomas (
            id_sintoma INTEGER PRIMARY KEY AUTOINCREMENT,
            nombre TEXT NOT NULL
        )
    ''')
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS reglas (
            id_regla INTEGER PRIMARY KEY AUTOINCREMENT,
            id_enfermedad INTEGER,
            id_sintoma INTEGER,
            FOREIGN KEY (id_enfermedad) REFERENCES enfermedades(id_enfermedad),
            FOREIGN KEY (id_sintoma) REFERENCES sintomas(id_sintoma)
        )
    ''')
