# Motor de inferencia
def diagnosticar(sintomas_usuario):
    conexion = sqlite3.connect('sistema_experto.db')
    cursor = conexion.cursor()

    # Obtener enfermedades y sus síntomas relacionados
    cursor.execute('''
        SELECT enfermedades.id_enfermedad, enfermedades.nombre, GROUP_CONCAT(sintomas.nombre) AS sintomas
        FROM reglas
        JOIN enfermedades ON reglas.id_enfermedad = enfermedades.id_enfermedad
        JOIN sintomas ON reglas.id_sintoma = sintomas.id_sintoma
        GROUP BY enfermedades.id_enfermedad, enfermedades.nombre
    ''')
    enfermedades = cursor.fetchall()
    
    diagnostico = []
    for id_enfermedad, enfermedad, sintomas in enfermedades:
        sintomas_asociados = sintomas.split(",")
        coincidencias = set(sintomas_usuario) & set(sintomas_asociados)
        if len(coincidencias) / len(sintomas_asociados) >= 0.5:  # Umbral del 50%
            diagnostico.append((id_enfermedad, enfermedad))
    
    # Obtener medicinas recomendadas para las enfermedades diagnosticadas
    resultado = []
    for id_enfermedad, enfermedad in diagnostico:
        cursor.execute('''
            SELECT nombre FROM medicinas WHERE id_enfermedad = ?
        ''', (id_enfermedad,))
        medicinas = [m[0] for m in cursor.fetchall()]
        resultado.append((enfermedad, medicinas))
    
    conexion.close()
    return resultado

# Interfaz en consola
def iniciar_sistema():
    conexion = sqlite3.connect('sistema_experto.db')
    cursor = conexion.cursor()
    
    # Obtener todos los síntomas disponibles
    cursor.execute('SELECT nombre FROM sintomas')
    sintomas_disponibles = [s[0] for s in cursor.fetchall()]
    conexion.close()
    
    print("Bienvenido al sistema experto médico")
    print("Por favor selecciona tus síntomas:")
    for i, sintoma in enumerate(sintomas_disponibles, start=1):
        print(f"{i}. {sintoma}")
    
    seleccion = input("Ingresa los números de los síntomas separados por comas: ")
    seleccion_indices = [int(i) - 1 for i in seleccion.split(",") if i.isdigit()]
    sintomas_usuario = [sintomas_disponibles[i] for i in seleccion_indices if i < len(sintomas_disponibles)]
    
    if not sintomas_usuario:
        print("No seleccionaste ningún síntoma válido.")
        return
    
    print("\nDiagnóstico en proceso...\n")
    diagnostico = diagnosticar(sintomas_usuario)
    
    if diagnostico:
        print("Posibles diagnósticos y medicinas recomendadas:")
        for enfermedad, medicinas in diagnostico:
            print(f"- {enfermedad}")
            print(f"  Medicinas sugeridas: {', '.join(medicinas) if medicinas else 'No hay medicinas sugeridas'}")
    else:
        print("No se encontraron diagnósticos con los síntomas proporcionados.")

# Configurar base de datos e iniciar el sistema
if __name__ == '__main__':
    configurar_base_datos()
    iniciar_sistema()
